DATABASE_URL="postgresql://resolve:resolve@localhost:5432/resolve_ai?schema=public"
DATABASE_URL_TEST="postgresql://resolve:resolve@localhost:5433/resolve_ai_test?schema=public"
# Usada só pelo Prisma CLI (migrate/generate/db seed), nunca pela app em
# runtime — ver `directUrl` em prisma/schema.prisma. Existe por causa da
# Vercel: a integração Vercel<->Neon injeta uma DATABASE_URL *pooled* (via
# PgBouncer) em produção, e o Prisma recomenda não rodar `migrate deploy`
# sobre uma conexão pooled (o lock consultivo de migração pode falhar via
# PgBouncer) — lá, DIRECT_DATABASE_URL aponta para a conexão direta do Neon.
# Aqui em dev local (e em db-test/CI) não existe pooling nenhum, então
# "direto" e "pooled" são a mesma coisa: use sempre o mesmo valor de
# DATABASE_URL. O Prisma exige DIRECT_DATABASE_URL resolvida sempre que
# declarada no schema, mesmo nestes ambientes sem distinção — sem isso,
# qualquer comando Prisma quebra.
DIRECT_DATABASE_URL="postgresql://resolve:resolve@localhost:5432/resolve_ai?schema=public"
# gere com: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Resolve Aí"

# Upload de imagem de ocorrência (src/modules/occurrence/infra/file-storage.ts):
# ausente = storage local (grava em .storage/uploads/, servido por
# GET /api/v1/uploads/[...key]) — o comportamento padrão em dev e Docker
# Compose. Em produção (Vercel), conecte um Blob store ao projeto para a
# plataforma injetar esta variável automaticamente; sem ela, o servidor
# ainda sobe, mas todo upload responde 500 (tenta gravar num filesystem
# somente-leitura). Não defina isto manualmente aqui — é a Vercel quem gera
# o valor ao conectar o Blob store.
# BLOB_READ_WRITE_TOKEN=
