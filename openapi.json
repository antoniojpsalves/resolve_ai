    "/api/v1/occurrences/{id}/rating": {
      "post": {
        "operationId": "rateOccurrence",
        "tags": ["Occurrences"],
        "summary": "Avalia uma ocorrência resolvida",
        "description": "Só o autor da ocorrência, e só quando `status === RESOLVIDA`. `201`, não `200`: cria um recurso novo (a avaliação). Autor de outra pessoa → mesmo 404 uniforme; `status` não é `RESOLVIDA` ou já foi avaliada → 409.",
        "security": [
          {
            "sessionCookieAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "ID (cuid) da ocorrência.",
              "example": "clx1a2b3c4d5e6f7g8h9"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "score": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "comment": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["score"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Avaliação registrada.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/RatingEntry"
